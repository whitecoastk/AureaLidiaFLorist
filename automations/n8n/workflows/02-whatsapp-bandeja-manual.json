{
  "name": "Áurea Lidia · preparar consultas WhatsApp · MANUAL",
  "active": false,
  "nodes": [
    {
      "id": "start",
      "name": "Ejecutar revisión",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "config",
      "name": "Configuración",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Sustituye solo la URL pública. El token se guarda en Credentials.\nreturn [{json:{webhook_url:\"https://TU_PROYECTO.supabase.co/functions/v1/whatsapp-webhook\"}}];"
      }
    },
    {
      "id": "pending",
      "name": "Obtener pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "parameters": {
        "url": "={{ $('Configuración').first().json.webhook_url + '?mode=pending' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "prepare",
      "name": "Preparar IDs para revisión",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items=$input.first().json.items;\nif(!Array.isArray(items)) throw new Error(\"Respuesta de bandeja inválida\");\nif(!items.length) return [];\nreturn [{json:{ids:items.map(item=>item.id),count:items.length}}];"
      }
    },
    {
      "id": "ready",
      "name": "Marcar listas para revisión",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').first().json.webhook_url + '?mode=ready' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {ids: $json.ids} }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "note",
      "name": "Alcance",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        230
      ],
      "parameters": {
        "content": "## Solo preparación de consultas\nConfigura URL y una credencial Header Auth llamada x-inbox-token en ambos nodos HTTP. No pegues el token en este JSON.\nNo crea pedidos ni pagos, no envía mensajes. Activo solo mediante ejecución manual.\nUna entrada vacía detiene el flujo sin marcar nada.",
        "height": 250,
        "width": 1050
      }
    }
  ],
  "connections": {
    "Ejecutar revisión": {
      "main": [
        [
          {
            "node": "Configuración",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuración": {
      "main": [
        [
          {
            "node": "Obtener pendientes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener pendientes": {
      "main": [
        [
          {
            "node": "Preparar IDs para revisión",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar IDs para revisión": {
      "main": [
        [
          {
            "node": "Marcar listas para revisión",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}
